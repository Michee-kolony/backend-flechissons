# =====================================================
# Cloudflare R2 (copier ce fichier en .env sur le serveur)
# Ne jamais mettre ces valeurs dans l'admin Angular ni dans git.
# =====================================================

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=flechissons

# URL publique du bucket (sans "/" final). Les anciennes prédications
# gardent leur URL actuelle quoi qu'il arrive.
R2_PUBLIC_URL=https://pub-d21c8c5e48fb4a35ace1050c88bc8b91.r2.dev

# =====================================================
# Téléversement multipart des prédications
# =====================================================

# Taille maximale d'un fichier audio / vidéo, en Mo (défaut : 5120 = 5 Go)
UPLOAD_MAX_TAILLE_MO=5120

# Délai après lequel un upload incomplet est annulé et nettoyé (défaut : 24)
UPLOAD_DELAI_ABANDON_HEURES=24
